{
  "description": "Restore Nightshift obligations and continue authorized unfinished runs.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/internal/runtime/hook.js\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/internal/runtime/hook.js\"", "timeout": 10 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/internal/runtime/hook.js\"", "timeout": 10 }] }
    ]
  }
}
